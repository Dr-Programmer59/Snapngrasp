# EAS Build Ignore File
# Copy of .gitignore with adjustments for EAS builds

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files (but we include .env for builds)
.env*.local

# typescript
*.tsbuildinfo

app-example

# generated native folders (EAS builds these)
/ios
/android

# IMPORTANT: Include .env file for EAS builds
# This overrides the ignore above
!.env
