PORT=8080
NODE_ENV=development

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-20250514

# OAuth
OAUTH_REDIRECT_URL=http://localhost:3000/auth/callback

# Google Vision
GOOGLE_APPLICATION_CREDENTIALS=./.gcp/vision-sa.json

# ElevenLabs Voice Agent
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_AGENT_ID=your_agent_id_here

# Canvas LMS
CANVAS_API_BASE_URL=
CANVAS_API_TOKEN=

# Sentry
SENTRY_DSN=

# CORS
CORS_ORIGIN=http://localhost:3000,https://your-mobile-app

# Apple IAP (auto-renewable subscriptions)
APPLE_IAP_SHARED_SECRET=your_apple_shared_secret_here
APPLE_IAP_MONTHLY_PRODUCT_ID=com.snapngrasp.pro.monthly
APPLE_IAP_YEARLY_PRODUCT_ID=com.snapngrasp.pro.yearly
APPLE_IAP_PRO_PLUS_MONTHLY_PRODUCT_ID=com.snapngrasp.proplus.monthly

# RevenueCat (keep secret key server-side only)
REVENUECAT_SECRET_API_KEY=your_revenuecat_secret_api_key_here
REVENUECAT_WEBHOOK_AUTH_HEADER=Bearer your_revenuecat_webhook_auth_token_here
REVENUECAT_ENTITLEMENT_PRO=pro
REVENUECAT_ENTITLEMENT_PRO_PLUS=pro_plus
